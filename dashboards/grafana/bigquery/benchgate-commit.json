{
  "uid": "bg-commit-bigquery",
  "title": "BenchGate · commit (bigquery)",
  "tags": [
    "benchgate",
    "commit"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "grafana-bigquery-datasource",
        "label": "Data source",
        "hide": 0
      },
      {
        "name": "project",
        "type": "textbox",
        "query": "my-project",
        "label": "GCP project"
      },
      {
        "name": "dataset",
        "type": "textbox",
        "query": "benchgate",
        "label": "Dataset"
      },
      {
        "name": "commit",
        "type": "query",
        "label": "Head commit",
        "datasource": {
          "type": "grafana-bigquery-datasource",
          "uid": "${datasource}"
        },
        "refresh": 2,
        "query": "SELECT DISTINCT head_commit FROM `${project}.${dataset}.verdicts` ORDER BY head_commit",
        "definition": "SELECT DISTINCT head_commit FROM `${project}.${dataset}.verdicts`"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Gate verdict",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "${datasource}"
          },
          "rawSql": "SELECT verdict, blocking, base_commit FROM `${project}.${dataset}.verdicts` WHERE head_commit = '$commit' ORDER BY created_at DESC LIMIT 1",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "fields": "/^verdict$/",
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Relative change with 95% bootstrap CI",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "${datasource}"
          },
          "rawSql": "SELECT workload || ' ' || metric AS test, 100 * ci_low AS ci_low_pct, 100 * rel_change AS change_pct, 100 * ci_high AS ci_high_pct FROM `${project}.${dataset}.verdict_tests` WHERE head_commit = '$commit' ORDER BY test",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "table",
      "title": "All tests",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "${datasource}"
          },
          "rawSql": "SELECT workload, metric, base_median / 1000 AS base_us, cand_median / 1000 AS head_us, round(100 * rel_change, 2) AS change_pct, round(100 * ci_low, 2) AS ci_low_pct, round(100 * ci_high, 2) AS ci_high_pct, p_value, p_adjusted, verdict FROM `${project}.${dataset}.verdict_tests` WHERE head_commit = '$commit' ORDER BY workload, metric",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "table",
      "title": "Per-run p50 (every run of this commit)",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "${datasource}"
          },
          "rawSql": "SELECT workload, node, repetition, p50_ns / 1000 AS p50_us, p99_ns / 1000 AS p99_us, sched_jitter_p99_us, involuntary_cs, started_at FROM `${project}.${dataset}.runs` WHERE commit = '$commit' ORDER BY workload, started_at",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
